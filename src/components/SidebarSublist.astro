---
import { Badge, Icon } from '@astrojs/starlight/components';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import NoteBadges from './badges/NoteBadges.astro';
import { parseNoteBadgeText } from '../utils/noteBadges';

type SidebarEntry = (typeof Astro.locals.starlightRoute.sidebar)[number];

interface Props {
  sublist: SidebarEntry[];
  nested?: boolean;
}

interface NoteLabel {
  number: string;
  displayLabel: string;
}

const { sublist, nested } = Astro.props;

function hasCurrentEntry(entries: SidebarEntry[]): boolean {
  return entries.some((entry) =>
    entry.type === 'link' ? entry.isCurrent : hasCurrentEntry(entry.entries)
  );
}

function cleanEnglishCandidate(value: string): string {
  return value
    .replace(/\s+/g, ' ')
    .replace(/^[\s,;:·/&—–-]+|[\s,;:·/&—–-]+$/g, '')
    .trim();
}

function extractLatinTokens(value: string): string {
  const tokens =
    value.match(/[A-Za-z0-9+.#/:-]*[A-Za-z][A-Za-z0-9+.#/:-]*|&/g) ?? [];

  while (tokens[0] === '&') tokens.shift();
  while (tokens.at(-1) === '&') tokens.pop();

  return tokens.join(' ');
}

function englishNameFromHref(href: string): string {
  const path = href.split(/[?#]/, 1)[0].replace(/\/+$/, '');
  let slug = path.slice(path.lastIndexOf('/') + 1);

  try {
    slug = decodeURIComponent(slug);
  } catch {
    // Keep the encoded slug when it cannot be decoded.
  }

  return slug
    .replace(/^\d+[_-]?/, '')
    .split(/[_-]+/)
    .filter(Boolean)
    .map((word) =>
      word.length === 1
        ? word.toUpperCase()
        : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(' ');
}

function getNoteLabel(label: string, href: string): NoteLabel | undefined {
  const match = label.match(/^(\d+)\.\s*(.+)$/u);
  if (!match) return undefined;

  const [, number, restValue] = match;
  const rest = restValue.trim();
  const hasLatin = (value: string) => /[A-Za-z]/.test(value);
  const hasHangul = (value: string) => /[ㄱ-ㅎㅏ-ㅣ가-힣]/u.test(value);
  let englishName = '';

  const finalParenthetical = rest.match(/^(.*?)\s*\(([^()]*)\)\s*$/u);
  if (finalParenthetical) {
    const before = cleanEnglishCandidate(finalParenthetical[1]);
    const inside = cleanEnglishCandidate(finalParenthetical[2]);

    if (hasLatin(before) && !hasHangul(before)) {
      englishName = before;
    } else if (hasLatin(inside)) {
      englishName = hasHangul(inside) ? extractLatinTokens(inside) : inside;
    }
  }

  if (!englishName) {
    const parentheticals = [...rest.matchAll(/\(([^()]*)\)/gu)].reverse();
    for (const parenthetical of parentheticals) {
      const candidate = cleanEnglishCandidate(parenthetical[1]);
      if (!hasLatin(candidate)) continue;
      englishName = hasHangul(candidate) ? extractLatinTokens(candidate) : candidate;
      break;
    }
  }

  if (!englishName) englishName = extractLatinTokens(rest);
  if (!englishName) englishName = englishNameFromHref(href);
  if (hasHangul(englishName)) {
    englishName = extractLatinTokens(englishName) || englishNameFromHref(href);
  }

  englishName = cleanEnglishCandidate(englishName) || 'Note';

  return {
    number,
    displayLabel: `${number}. ${englishName}`,
  };
}
---

<ul class:list={{ 'top-level': !nested }}>
  {
    sublist.map((entry) => {
      const parsedBadge = entry.badge ? parseNoteBadgeText(entry.badge.text) : {};
      const isStructuredNoteBadge = Boolean(
        parsedBadge.status || parsedBadge.priority !== undefined
      );
      const noteLabel =
        entry.type === 'link' ? getNoteLabel(entry.label, entry.href) : undefined;

      return (
        <li>
          {entry.type === 'link' ? (
            <a
              {...entry.attrs}
              href={entry.href}
              aria-current={entry.isCurrent ? 'page' : undefined}
              data-note-link={noteLabel ? 'true' : undefined}
              data-note-number={noteLabel?.number}
              class:list={[{ large: !nested }, entry.attrs.class]}
            >
              <span class={noteLabel ? 'note-link-label' : undefined}>
                {noteLabel?.displayLabel ?? entry.label}
              </span>
              {entry.badge && (
                isStructuredNoteBadge ? (
                  <NoteBadges
                    badgeText={entry.badge.text}
                    size="small"
                    class="note-link-badges"
                  />
                ) : (
                  <Badge
                    variant={entry.badge.variant}
                    class={entry.badge.class}
                    text={entry.badge.text}
                  />
                )
              )}
              {noteLabel && (
                <span class="last-read-indicator" hidden>최근 열람한 노트</span>
              )}
            </a>
          ) : (
            <details open={hasCurrentEntry(entry.entries) || !entry.collapsed}>
              <summary>
                <span class="group-label">
                  <span class="large">{entry.label}</span>
                  {entry.badge && (
                    isStructuredNoteBadge ? (
                      <NoteBadges
                        badgeText={entry.badge.text}
                        size="small"
                        class="note-link-badges"
                      />
                    ) : (
                      <Badge
                        variant={entry.badge.variant}
                        class={entry.badge.class}
                        text={entry.badge.text}
                      />
                    )
                  )}
                </span>
                <Icon name="right-caret" class="caret" size="1.25rem" />
              </summary>
              <SidebarRestorePoint />
              <Astro.self sublist={entry.entries} nested />
            </details>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  @layer starlight.core {
    ul {
      --sl-sidebar-item-padding-inline: 0.5rem;
      list-style: none;
      padding: 0;
    }

    li {
      overflow-wrap: anywhere;
    }

    ul ul li {
      margin-inline-start: var(--sl-sidebar-item-padding-inline);
      border-inline-start: 1px solid var(--sl-color-hairline-light);
      padding-inline-start: var(--sl-sidebar-item-padding-inline);
    }

    .large {
      font-size: var(--sl-text-lg);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    .top-level > li + li {
      margin-top: 0.75rem;
    }

    summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.2em var(--sl-sidebar-item-padding-inline);
      line-height: 1.4;
      cursor: pointer;
      user-select: none;
      border-radius: 0.25rem;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    summary:hover {
      background-color: color-mix(in srgb, var(--sl-color-gray-5) 40%, transparent);
    }

    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }

    .caret {
      transition: transform 0.2s ease-in-out;
      flex-shrink: 0;
    }

    :global([dir='rtl']) .caret {
      transform: rotateZ(180deg);
    }

    [open] > summary .caret {
      transform: rotateZ(90deg);
    }

    a {
      display: block;
      border-radius: 0.25rem;
      text-decoration: none;
      color: var(--sl-color-gray-2);
      padding: 0.3em var(--sl-sidebar-item-padding-inline);
      line-height: 1.4;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    a[data-note-link='true'] {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.25rem;
    }

    .note-link-label {
      flex: 1 1 9rem;
      min-width: 0;
    }

    :global(.note-link-badges) {
      display: inline-flex;
      flex: 0 0 auto;
      gap: 0.25rem;
      margin-inline-start: auto;
    }

    a:hover,
    a:focus {
      color: var(--sl-color-white);
      background-color: color-mix(in srgb, var(--sl-color-gray-5) 40%, transparent);
    }

    a:focus-visible {
      outline: 2px solid var(--sl-color-accent-high);
      outline-offset: 2px;
    }

    a[data-last-read='true'] {
      color: var(--sl-color-white);
      background-color: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
      box-shadow: inset 0.2rem 0 0 var(--sl-color-accent);
    }

    a[data-last-read='true'] .note-link-label::before {
      content: '';
      display: inline-block;
      width: 0.45em;
      height: 0.45em;
      margin-inline-end: 0.35em;
      border-radius: 50%;
      background-color: var(--sl-color-accent-high);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--sl-color-accent) 24%, transparent);
      vertical-align: 0.1em;
    }

    [aria-current='page'],
    [aria-current='page']:hover,
    [aria-current='page']:focus {
      font-weight: 600;
      color: var(--sl-color-text-invert);
      background-color: var(--sl-color-text-accent);
    }

    [aria-current='page'][data-last-read='true'] {
      box-shadow: inset 0.2rem 0 0 currentColor;
    }

    [aria-current='page'][data-last-read='true'] .note-link-label::before {
      background-color: currentColor;
      box-shadow: none;
    }

    .last-read-indicator {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .last-read-indicator[hidden] {
      display: none;
    }

    a:not([data-note-link='true']) > *:not(:last-child),
    .group-label > *:not(:last-child) {
      margin-inline-end: 0.25em;
    }

    @media (min-width: 50rem) {
      .top-level > li + li {
        margin-top: 0.5rem;
      }

      .large {
        font-size: var(--sl-text-base);
      }

      a {
        font-size: var(--sl-text-sm);
      }
    }
  }
</style>
