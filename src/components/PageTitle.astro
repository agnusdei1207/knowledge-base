---
import NoteBadges from './badges/NoteBadges.astro';
import type { NoteExtraMetadata } from '../types/note';

const { title, extra } = Astro.locals.starlightRoute.entry.data as {
  title: string;
  extra?: NoteExtraMetadata;
};

const questionNo = extra?.question_no;
const status = extra?.source_status;
const priority = extra?.priority;
---

{
  questionNo && (
    <p class="note-number">
      <span>노트</span>
      <strong>{questionNo}</strong>
    </p>
  )
}

<h1 id="_top">{title}</h1>

{
  (status || priority !== undefined) && (
    <NoteBadges
      status={status}
      priority={priority}
      prefixPriority="예상 "
      size="medium"
      class="note-header-badges"
    />
  )
}

<style>
  @layer starlight.core {
    .note-number {
      display: inline-flex;
      align-items: baseline;
      gap: 0.45rem;
      margin: 1rem 0 0;
      border: 1px solid color-mix(in srgb, var(--palette-accent) 55%, transparent);
      border-radius: 999px;
      padding: 0.2rem 0.65rem;
      color: var(--palette-muted);
      background: color-mix(in srgb, var(--palette-accent) 12%, transparent);
      font-size: var(--sl-text-sm);
      line-height: 1.35;
    }

    .note-number strong {
      color: var(--palette-accent-glow);
      font-family: var(--sl-font-mono);
      font-size: var(--sl-text-base);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.04em;
    }

    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--palette-text);
      font-family: Georgia, "Noto Serif KR", serif;
    }

    .note-number + h1 {
      margin-top: 0.65rem;
    }

    :global(.note-header-badges) {
      margin-top: 0.75rem;
      gap: 0.5rem;
    }
  }
</style>
